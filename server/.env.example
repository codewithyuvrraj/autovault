# ============================================================
# AutoVault API — environment variables
# Copy this file to .env locally, or use these keys on your host
# (Render dashboard → Environment). Example local values shown.
# ============================================================

# ---- MySQL (local: your official MySQL; hosted: free TiDB Cloud / Aiven) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=car_platform
# Set to true for hosted databases (TiDB Cloud / Aiven require TLS). Keep off locally.
MYSQL_SSL=false

# ---- Google OAuth (same credentials as local, callback must match the API host) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:   http://localhost:5001/api/auth/google/callback
# Hosted:  https://<service>.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Where the browser lands after Google sign-in (the FRONTEND, not the API)
FRONTEND_URL=http://localhost:5173
# CORS allowed origin (the frontend URL). Locally unset = reflect any origin.
CLIENT_ORIGIN=

# Random 64-hex secret for JWT session signing (generate: openssl rand -hex 32)
JWT_SECRET=

# Port (Render sets this automatically; locally defaults to 5001)
# PORT=5001
